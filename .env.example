DATABASE_URL=postgresql://postgres:password@localhost:5432/runway
REDIS_URL=redis://localhost:6379

RUNWAY_PROVIDER=direct
RUNWAY_DEFAULT_MODEL=gen4
RUNWAY_EXPLORE_MODE=true

API_PORT=5102

# Single token
RUNWAY_TOKEN=your_runway_jwt_token
RUNWAY_TEAM_ID=your_team_id

# Multi-token (optional, format: token1:teamId1,token2:teamId2)
RUNWAY_TOKENS=

POLL_INTERVAL_QUEUED_MS=15000
POLL_INTERVAL_PROCESSING_MS=10000
RUNWAY_JOB_TIMEOUT_MS=1800000
