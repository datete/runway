generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username       String           @unique @db.VarChar(64)
  passwordHash   String           @map("password_hash")
  role           String           @default("user") @db.VarChar(16)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  dailyQuota     Int?             @map("daily_quota")
  isActive       Boolean          @default(true) @map("is_active")
  maxConcurrency Int?             @map("max_concurrency")
  totalQuota     Int?             @map("total_quota")
  maxDevices    Int?        @default(3) @map("max_devices")
  sessions      LoginSession[]
  jobs           RunwayJob[]
  devices       UserDevice[]
  logs           UserLog[]

  @@map("users")
}

model UserLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(64)
  detail    String?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_logs")
}

model RunwayJob {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?          @map("user_id") @db.Uuid
  provider        String           @default("useapi") @db.VarChar(32)
  mode            String           @db.VarChar(32)
  prompt          String
  imageUrl        String?          @map("image_url")
  status          String           @default("pending") @db.VarChar(32)
  remoteTaskId    String?          @map("remote_task_id") @db.VarChar(128)
  exploreMode     Boolean          @default(true) @map("explore_mode")
  modelName       String           @default("gen4") @map("model_name") @db.VarChar(64)
  resultUrl       String?          @map("result_url")
  thumbnailUrl    String?          @map("thumbnail_url")
  errorMessage    String?          @map("error_message")
  retryCount      Int              @default(0) @map("retry_count")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  startedAt       DateTime?        @map("started_at")
  finishedAt      DateTime?        @map("finished_at")
  referenceImages String?          @map("reference_images")
  usedToken       String?          @map("used_token") @db.VarChar(64)
  duration        Int?
  remark          String?
  accountId       String?          @map("account_id") @db.Uuid
  resolution      String?          @db.VarChar(32)
  quality         String?          @db.VarChar(32)
  cfgScale        Float?           @map("cfg_scale")
  sound           Boolean?
  videoUrl        String?          @map("video_url")
  progress        Float?           @default(0)
  events          RunwayJobEvent[]
  account         RunwayAccount?   @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User?            @relation(fields: [userId], references: [id])

  @@index([status], map: "idx_runway_jobs_status")
  @@index([userId], map: "idx_runway_jobs_user_id")
  @@index([accountId], map: "idx_runway_jobs_account_id")
  @@index([createdAt], map: "idx_runway_jobs_created_at")
  @@index([remoteTaskId], map: "idx_runway_jobs_remote_task_id")
  @@map("runway_jobs")
}

model RunwayJobEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String    @map("job_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(32)
  message     String?
  payloadJson Json?     @map("payload_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  job         RunwayJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "idx_runway_job_events_job_id")
  @@map("runway_job_events")
}

model RunwayAccount {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label            String      @db.VarChar(64)
  token            String
  tokenShort       String      @map("token_short") @db.VarChar(16)
  teamId           String      @map("team_id") @db.VarChar(32)
  proxyUrl         String?     @map("proxy_url")
  maxConcurrency   Int         @default(2) @map("max_concurrency")
  isActive         Boolean     @default(true) @map("is_active")
  priority         Int         @default(0)
  tokenExpiresAt   DateTime?   @map("token_expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime?   @map("last_used_at") @db.Timestamptz(6)
  lastErrorAt      DateTime?   @map("last_error_at") @db.Timestamptz(6)
  lastErrorMessage String?     @map("last_error_message")
  totalGenerated   Int         @default(0) @map("total_generated")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobs             RunwayJob[]

  @@map("runway_accounts")
}

model LoginSession {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  deviceId         String?      @map("device_id") @db.Uuid
  ip               String       @db.VarChar(64)
  city             String?      @db.VarChar(128)
  region           String?      @db.VarChar(128)
  country          String?      @db.VarChar(8)
  userAgent        String?      @map("user_agent")
  isSuspicious     Boolean?     @default(false) @map("is_suspicious")
  suspiciousReason String?      @map("suspicious_reason") @db.VarChar(256)
  createdAt        DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  device           UserDevice?  @relation(fields: [deviceId], references: [id], onUpdate: NoAction)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_login_sessions_created")
  @@index([userId], map: "idx_login_sessions_user")
  @@map("login_sessions")
}

model UserDevice {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  fingerprint   String          @db.VarChar(128)
  deviceName    String?         @map("device_name") @db.VarChar(256)
  browser       String?         @db.VarChar(128)
  os            String?         @db.VarChar(128)
  firstSeenAt   DateTime?       @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt    DateTime?       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  lastIp        String?         @map("last_ip") @db.VarChar(64)
  isTrusted     Boolean?        @default(false) @map("is_trusted")
  isBlocked     Boolean?        @default(false) @map("is_blocked")
  sessions      LoginSession[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, fingerprint])
  @@index([userId], map: "idx_user_devices_user")
  @@map("user_devices")
}
