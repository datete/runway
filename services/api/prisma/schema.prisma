generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String     @unique @db.VarChar(64)
  passwordHash String     @map("password_hash")
  role         String     @default("user") @db.VarChar(16)
  isActive       Boolean    @default(true) @map("is_active")
  maxConcurrency Int?       @map("max_concurrency")
  dailyQuota     Int?       @map("daily_quota")
  totalQuota     Int?       @map("total_quota")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  jobs         RunwayJob[]
  logs         UserLog[]

  @@map("users")
}

model UserLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(64)
  detail    String?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_logs")
}

model RunwayJob {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  provider        String    @default("useapi") @db.VarChar(32)
  mode            String    @db.VarChar(32)
  prompt          String
  imageUrl        String?   @map("image_url")
  referenceImages String?   @map("reference_images")
  status          String    @default("pending") @db.VarChar(32)
  remoteTaskId    String?   @map("remote_task_id") @db.VarChar(128)
  exploreMode     Boolean   @default(true) @map("explore_mode")
  modelName       String    @default("gen4") @map("model_name") @db.VarChar(64)
  resultUrl       String?   @map("result_url")
  thumbnailUrl    String?   @map("thumbnail_url")
  errorMessage    String?   @map("error_message")
  retryCount      Int       @default(0) @map("retry_count")
  usedToken       String?   @map("used_token") @db.VarChar(64)
  duration        Int?
  remark          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  user            User?     @relation(fields: [userId], references: [id])
  events          RunwayJobEvent[]

  @@map("runway_jobs")
}

model RunwayJobEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String    @map("job_id") @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(32)
  message     String?
  payloadJson Json?     @map("payload_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  job         RunwayJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("runway_job_events")
}
